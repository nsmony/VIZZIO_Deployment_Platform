{
  "name": "documentation",
  "version": "0.0.9",
  "private": true,
  "scripts": {
    "docs:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-docs.ps1",
    "guide:build": "node scripts/generate-full-guide.mjs",
    "prebuild": "npm run docs:sync",
    "build": "next build",
    "predev": "npm run docs:sync",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next build",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11"
  }
}
